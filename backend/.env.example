# AI API keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Standalone AI service connection
AI_SERVICE_URL=http://localhost:9001/api/ai
INTERNAL_API_KEY=your_shared_internal_api_key_here

# Server Port
PORT=9000

# Database configurations
DB_URL=jdbc:mysql://localhost:3306/travelbillingdb?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Security settings
JWT_SECRET=your_32_character_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
