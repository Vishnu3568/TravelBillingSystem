{
  "name": "travel-billing-ai",
  "version": "1.0.0",
  "description": "Standalone AI Service for Travel Billing System",
  "main": "server.js",
  "scripts": {
    "start": "concurrently \"node server.js\" \"../backend/.venv/Scripts/python -m uvicorn main:app --app-dir agents/rag --port 9002\"",
    "dev": "concurrently \"nodemon server.js\" \"../backend/.venv/Scripts/python -m uvicorn main:app --app-dir agents/rag --port 9002 --reload\""
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14"
  }
}
